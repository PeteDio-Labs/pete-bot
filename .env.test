# Test environment.
#
# ⚠ THIS FILE IS WHY THE PRODUCT HAD NO TESTS. It carried ALLOWED_USER_IDS, QBIT_* and
# OLLAMA_* from the torn-down Mission Control bot and never set OWNER_USER_ID, which
# config.ts requires with no default. Every product module imports config transitively,
# so importing one under test threw before a single assertion ran — and the suite stayed
# green because it only ever touched logger and metrics. Keep this in step with
# .env.example: a variable that is required there and missing here makes the whole
# shipping surface untestable again, silently.
DISCORD_TOKEN=test-token
DISCORD_CLIENT_ID=000000000000000000
OWNER_USER_ID=111111111111111111

MTRACE_URL=http://127.0.0.1:8237
MTRACE_API_TOKEN=test-mtrace-token
MTRACE_TIMEOUT_MS=1000

# Off by default: a test that binds a real port races every other test file.
HTTP_SERVER_ENABLED=false
HTTP_SERVER_PORT=3015
ALERT_BEARER_TOKEN=test-alert-token
# Two DOWNs inside this window share one message. Tests drive it with fake timers.
ALERT_COALESCE_MS=60000
# Empty means memory-only, which is what a test wants unless it is testing persistence.
ALERT_STATE_PATH=

# /update (PET-395). Tests fake GitHub at fetch; the token only has to be non-empty.
GITHUB_UPDATES_TOKEN=test-gh-token
UPDATES_REPO=PeteDio-Labs/petedio-media-iac
UPDATES_WORKFLOW=media-updates.yml
UPDATES_POLL_MS=1

METRICS_ENABLED=true
METRICS_PORT=9090
LOG_LEVEL=silent
