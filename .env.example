# Discord — the app is USER-INSTALLED, not added to a server.
# Developer Portal → Installation → set "User Install", scope applications.commands.
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# The only account this app answers, and the only account it DMs.
# Every interaction is compared against this id; an app installed by anyone else
# answers nobody.
OWNER_USER_ID=123456789012345678

# HTTP intake for Uptime Kuma alerts.
HTTP_SERVER_ENABLED=true
HTTP_SERVER_PORT=3015
# Bearer token Kuma sends on POST /v1/alert. Not HMAC: Kuma's generic webhook
# cannot sign a body.
ALERT_BEARER_TOKEN=
# Bearer token sessions send on POST /v1/notify. Keep it different from the alert
# token, so a session that can DM the owner cannot post a fake alert. Empty refuses
# every request.
NOTIFY_BEARER_TOKEN=

# Monitors that fail inside this window share one DM, so a node reboot taking eight
# services down reads as one incident. Bounded on purpose: an edit raises no Discord
# notification, so an unbounded window would fold a new outage silently into an old
# message. Set 0 to disable grouping.
ALERT_COALESCE_MS=60000

# Where open incidents are remembered, so a restart between DOWN and UP still edits the
# original message. Empty means memory only. In production systemd's StateDirectory=
# creates the directory; nothing else on the filesystem is writable.
ALERT_STATE_PATH=

METRICS_ENABLED=true
METRICS_PORT=9090
LOG_LEVEL=info

# The Anthropic API gateway (PET-617). Empty ANTHROPIC_API_KEY leaves it off: the route
# answers 503 and the rest of the bot runs as before. With a key set, the other two are
# required, or the gateway refuses every request and /health reports "misconfigured".
# Pedro seeds the key and each caller's token in Vault; never paste one here.
ANTHROPIC_API_KEY=
# JSON: caller name to its bearer, its monthly cap in whole dollars, and its models.
# {"pm-agent":{"token":"<48+ chars>","monthlyCapUsd":15,"models":["claude-haiku-4-5"]}}
LLM_GATEWAY_CALLERS=
# The spend ledger the caps read. It must survive a restart, so keep it under the
# StateDirectory, next to the alert state.
LLM_LEDGER_PATH=

# /lab (PET-669): pete-bot relays the question to lab-agent on 127.0.0.1. Empty leaves /lab
# answering that it is not configured. lab-agent's own settings (LAB_PVE_*, LAB_GATEWAY_*,
# the clone paths) live in its own env file, never here: see src/lab/config.ts.
LAB_AGENT_URL=http://127.0.0.1:3016
LAB_ASK_TOKEN=

# /update (PET-395): a fine-grained token limited to PeteDio-Labs/petedio-media-iac, with
# Actions read and write. Empty leaves /update answering that it is not configured.
GITHUB_UPDATES_TOKEN=
UPDATES_REPO=PeteDio-Labs/petedio-media-iac
UPDATES_WORKFLOW=media-updates.yml

# The merge desk (PET-645). Empty or `off` leaves it off. `dry-run` does everything except
# approve and merge, and DMs what it would have merged. `on` merges tiers 0 and 1 and asks
# for one tap on tier 2. A missing or malformed setting below turns the desk off, never the
# bot, and /health says why.
DESK_MODE=
# Repositories under DESK_ORG (default PeteDio-Labs) to watch, comma-separated.
DESK_REPOS=petedio-workspace,petedio-vault,petedio-pm
# Repos on DESK_REPOS that run no PR validation, by decision. Only there may a head with no
# check at all merge without a tap.
DESK_NO_CI_REPOS=petedio-workspace,petedio-vault,petedio-pm
# GitHub logins whose PRs may merge. Anyone else's PR is skipped.
DESK_AUTHORS=petedillo
# pete-bot's own GitHub App. The key is a file, seeded by script, never pasted here.
DESK_APP_ID=
DESK_INSTALLATION_ID=
DESK_APP_KEY_PATH=/etc/pete-bot/desk-app.pem
# What the desk queued and asked, so a restart neither re-queues nor re-asks.
DESK_STATE_PATH=/var/lib/pete-bot/desk.sqlite
# codex-248's review gate. The key is this host's; 248 forces it to codex-review-gate.
DESK_CODEX_SSH_TARGET=codex@192.168.50.248
DESK_CODEX_SSH_KEY=/etc/pete-bot/codex_ed25519
DESK_CODEX_KNOWN_HOSTS=/etc/pete-bot/codex_known_hosts
# Optional: DESK_POLL_MS (default 180000), DESK_CODEX_TIMEOUT_MS (default 5400000),
# DESK_PYTHON (default python3), DESK_CLASSIFIER_REPO and DESK_CLASSIFIER_PATH (default
# petedio-iac's scripts/pr-blast-radius.py).

# The scheduled reports (PET-701). They replace the Morning queue, Hanging audit and Stale
# PR sweep Claude routines with code that reads GitHub and Plane and DMs the owner. Empty or
# `off` sends nothing. `on` runs the schedule. A bad setting turns the reports off, never the
# bot, and /health says why. GitHub is read as the desk's App (DESK_APP_* above), in any desk mode.
REPORTS_MODE=
REPORT_REPOS=petedio-iac,petedio-workspace,petedio-vault,petedio-pm,pete-bot
# Read-only Plane. Empty leaves every report saying "Plane not read".
PLANE_API_KEY=
PLANE_BASE_URL=http://192.168.50.235:8080
# What each report last sent, so a restart neither repeats nor loses one.
REPORT_STATE_PATH=/var/lib/pete-bot/reports.json
# Optional: REPORTS_ENABLED (default morning,audit,sweep), REPORT_SWEEP_WEEKLY=true (sweep
# on Mondays only), REPORT_STALE_DAYS (default 3), REPORT_VAULT_PATH (a read-only vault
# clone, for the audit's `verified:` dates), PLANE_WORKSPACE, PLANE_PROJECT_ID.
